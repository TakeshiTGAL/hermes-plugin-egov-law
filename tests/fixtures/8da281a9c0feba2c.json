     "children": [
      "（債務不履行による損害賠償）"
     ]
    },
    {
     "tag": "ArticleTitle",
     "attr": {},
     "children": [
      "第四百十五条"
     ]
    },
    {
     "tag": "Paragraph",
     "attr": {
      "Num": "1"
     },
     "children": [
      {
       "tag": "ParagraphNum",
       "attr": {},
